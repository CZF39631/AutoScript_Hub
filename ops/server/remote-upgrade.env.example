# 复制为同目录 remote-upgrade.env 后按实际服务器填写。
# 此文件只保存连接位置和部署路径；服务密码、JWT 密钥等仍只保存在远程 deploy/.env。

SSH_HOST=server.example.internal
SSH_USER=autoscript
SSH_IDENTITY_FILE=~/.ssh/id_ed25519

REMOTE_DEPLOY_DIR=/opt/autoscript-hub
REMOTE_COMPOSE_FILE=/opt/autoscript-hub/compose.yaml
REMOTE_ENV_FILE=/opt/autoscript-hub/.env
REMOTE_DATA_DIR=/opt/autoscript-hub/data
REMOTE_PROJECT_NAME=autoscript-hub
REMOTE_PORT=8000

IMAGE_REPOSITORY=ghcr.io/czf39631/autoscript-hub-server
TARGET_VERSION=1.2.0
# 只有目标镜像已通过 docker load 导入远程服务器时才设为 1。
SKIP_PULL=0
