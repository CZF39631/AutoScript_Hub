# Copy to deploy/.env and replace every CHANGE_ME value before first start.
AUTOSCRIPT_SERVER_IMAGE=ghcr.io/czf39631/autoscript-hub-server:1.0.0
# Docker Hub is the default. In networks where Docker Hub is unreachable, use a
# compatible proxy such as docker.m.daocloud.io/library without changing daemon settings.
AUTOSCRIPT_BASE_REGISTRY=docker.io/library
AUTOSCRIPT_BIND_ADDRESS=0.0.0.0
AUTOSCRIPT_PORT=8000
AUTOSCRIPT_DATA_DIR=/opt/autoscript-hub/data
AUTOSCRIPT_UID=1000
AUTOSCRIPT_GID=1000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_ARCHIVE_RETENTION_DAYS=90
# Same-origin web use needs no CORS entry. Separate origins are comma-separated.
CORS_ORIGINS=

# Optional external authentication (disabled by default). Configuration shown
# below matches a generic nested JSON response and can be changed without code.
EXTERNAL_AUTH_ENABLED=false
# Supported methods: http_form, http_json
EXTERNAL_AUTH_METHOD=http_form
EXTERNAL_AUTH_URL=https://identity.example.com/api/login
EXTERNAL_AUTH_TIMEOUT_SECONDS=10
EXTERNAL_AUTH_VERIFY_TLS=true
EXTERNAL_AUTH_USERNAME_FIELD=username
EXTERNAL_AUTH_PASSWORD_FIELD=password
EXTERNAL_AUTH_SUCCESS_PATH=success
# Dotted paths below are examples only; configure them for the provider's JSON response.
EXTERNAL_AUTH_SUBJECT_PATH=data.user.id
EXTERNAL_AUTH_USERNAME_PATH=data.user.username
EXTERNAL_AUTH_DISPLAY_NAME_PATH=data.user.display_name
EXTERNAL_AUTH_ROLE_PATH=data.user.role
# Map external roles only to operator, developer, or admin. Unknown roles are denied.
EXTERNAL_AUTH_ROLE_MAP={"user":"operator","maintainer":"developer","administrator":"admin"}

# LAN release-cache: shared secret for authenticated sync uploads from the
# self-hosted GitHub Actions runner. Leave empty to disable the sync endpoint
# (anonymous reads still work if a cache was populated out-of-band).
RELEASE_CACHE_SYNC_TOKEN=
