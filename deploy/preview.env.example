# 复制到独立测试部署目录的 deploy/.env，不覆盖正式 deploy/.env。
# 不填写生产凭据，不复用生产数据库/数据卷。先构建测试镜像，再指定其不可变摘要或本地测试 Tag。
AUTOSCRIPT_PREVIEW_IMAGE=
AUTOSCRIPT_PREVIEW_PORT=
# 默认仅本机可达；开放地址/反向代理入口需要单独确认。
AUTOSCRIPT_PREVIEW_BIND_ADDRESS=127.0.0.1
AUTOSCRIPT_PREVIEW_JWT_SECRET=
AUTOSCRIPT_PREVIEW_ADMIN_USERNAME=preview-admin
AUTOSCRIPT_PREVIEW_ADMIN_PASSWORD=
AUTOSCRIPT_PREVIEW_MEMORY_LIMIT=512m
AUTOSCRIPT_PREVIEW_CPUS=1.0
